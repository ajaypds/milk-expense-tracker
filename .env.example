# ==============================================================================
# ⚡ Supabase Configuration (Upgrade & Migration)
# ==============================================================================
# From Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Service Role Key (Used ONLY by backend/migration scripts - keep secret, DO NOT prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Local path to Firebase Service Account JSON (used for Firestore -> Supabase data migration)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH="./scripts/serviceAccountKey.json"

# ==============================================================================
# 🔥 Firebase Configuration (Active until migration is complete)
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
